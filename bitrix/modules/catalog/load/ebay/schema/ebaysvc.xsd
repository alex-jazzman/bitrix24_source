						</CallInfo>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransactionPercent" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Percentage of number of times a member has sold successfully vs. the number of
						times a member has bought an item in the preceding 365 days.
					</xs:documentation>
					<xs:appinfo>
						<CallInfo>
