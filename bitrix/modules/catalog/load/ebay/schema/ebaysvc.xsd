        <xs:element name="UserAgreementInfo" type="ns:UserAgreementInfoType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
                <xs:documentation>
                  Container consisting of details related to the current status of a DE or AT seller signing the required 
