<!--

##### from file eBLBaseComponents/public/BestOfferIDType.xsd #####

-->
	<xs:simpleType name="BestOfferIDType">
		<xs:annotation>
			<xs:documentation>
				Unique identifier for a Best Offer (to differentiate from
