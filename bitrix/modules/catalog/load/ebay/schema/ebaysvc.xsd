			<xs:enumeration value="BulkyGoods">
				<xs:annotation>
					<xs:documentation>
						Bulky goods
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Furniture">
				<xs:annotation>
					<xs:documentation>
						Furniture
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Cars">
				<xs:annotation>
					<xs:documentation>
						Cars
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Motorbikes">
				<xs:annotation>
					<xs:documentation>
						Motorbikes
					</xs:documentation>
				</xs:annotation>
