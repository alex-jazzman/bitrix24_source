								</CallInfo>
							</xs:appinfo>
						</xs:annotation>
					</xs:element>
					<xs:element name="CategoryID" type="xs:string" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								ID of the primary category in which the item was listed.
								Only returned if you set Item.CategoryMappingAllowed to true in the request
