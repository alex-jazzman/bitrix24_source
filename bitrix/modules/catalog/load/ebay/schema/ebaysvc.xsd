			</xs:element>
			<xs:element name="ExpirationTime" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Date and time when this notification will be removed from the
						eBay system.
					</xs:documentation>
					<xs:appinfo>
						<CallInfo>
							<CallName>GetNotificationsUsage</CallName>
							<Returned>Conditionally</Returned>
