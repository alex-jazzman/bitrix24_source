			</xs:enumeration>
			<xs:enumeration value="ISBN">
				<xs:annotation>
					<xs:documentation>
						International Standard Book Number (ISBN).
						ISBNs can contain either 10 or 13 characters.
						Max length 13.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UPC">
