							<CallName>GetSellingManagerTemplateAutomationRule</CallName>
							<CallName>SetSellingManagerItemAutomationRule</CallName>
							<Returned>Conditionally</Returned>
						</CallInfo>
						<CallInfo>
							<CallName>SetSellingManagerTemplateAutomationRule</CallName>
