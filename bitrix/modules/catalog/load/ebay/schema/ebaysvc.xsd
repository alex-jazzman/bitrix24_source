						</CallInfo>
						<CallInfo>
							<CallName>GetItem</CallName>
							<CallName>GetSellingManagerTemplates</CallName>
							<CallName>GetSellerList</CallName>
							<Details>DetailLevel: ItemReturnDescription, ReturnAll</Details>
							<Returned>Conditionally</Returned>
						</CallInfo>
					</xs:appinfo>
				</xs:annotation>
